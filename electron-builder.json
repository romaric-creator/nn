{
  "appId": "com.flexystore.shop",
  "productName": "Flexy Store",
  "asar": true,
  "asarUnpack": [
    "node_modules/sqlite3/**/*",
    "node_modules/bcryptjs/**/*"
  ],
  "files": [
    "dist/**/*",
    "src/main/**/*",
    "src/preload/**/*",
    "node_modules/sqlite3/**/*",
    "node_modules/bcryptjs/**/*",
    "node_modules/winston/**/*",
    "node_modules/winston-daily-rotate-file/**/*",
    "node_modules/exceljs/**/*"
  ],
  "directories": {
    "buildResources": "build",
    "output": "release"
  },
  "extraResources": [
    {
      "from": "src/main/db/schema.sql",
      "to": "schema.sql"
    },
    {
      "from": "seed.sql",
      "to": "seed.sql"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "requestedExecutionLevel": "asInvoker"
  },
  "linux": {
    "target": "AppImage",
    "category": "Utility"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Flexy Store",
    "perMachine": false
  }
}
